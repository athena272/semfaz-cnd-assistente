{
  "name": "semfaz-cnd-assistente",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Assistente local SEMFAZ Aracaju: emissão de CND com Playwright e Gemini no reCAPTCHA v2",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm test",
    "emitir": "tsx src/cli/emitir.ts",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "sharp": "^0.34.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "playwright": "^1.51.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "packageManager": "pnpm@9.15.0"
}
