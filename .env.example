# Nunca commitar .env

# Aspas obrigatórias: sem elas o dotenv trata #/... como comentário
SEMFAZ_CND_URL="https://fazenda.aracaju.se.gov.br/#/publica/contribuinte/certidoes/certidao-negativa"

# Google AI Studio (free tier) — mesmo tipo de chave do gol-ponto-assistente
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelo com suporte a áudio (desafio dos fones)
GEMINI_AUDIO_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000

# false = browser visível (recomendado no experimento)
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOW_MO_MS=50
PLAYWRIGHT_TIMEOUT_MS=90000

# audio (padrão) | tiles
RECAPTCHA_MODE=audio
RECAPTCHA_MAX_ROUNDS=6
# Só usado no modo tiles
RECAPTCHA_UPSCALE=2

DOWNLOAD_DIR=downloads
TZ=America/Sao_Paulo
LOG_LEVEL=info
